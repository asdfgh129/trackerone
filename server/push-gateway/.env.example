# 推送网关配置示例。
#
# 复制为 .env 后按需修改；.env 不要提交到 git。
# 只放服务端密钥：TRACCAR_WEBHOOK_SECRET、JPUSH_MASTER_SECRET、ADMIN_TOKEN。

# ---- 服务 ----
LISTEN_ADDR=":8080"
LOG_LEVEL=info

# ---- Traccar ----
# Traccar 实例地址，用于校验客户端令牌（不配则跳过校验，仅限本地联调）。
TRACCAR_BASE_URL=https://track.example.com
# Traccar 与网关之间的共享密钥，必须与 notificator.webhook.secret 一致。
TRACCAR_WEBHOOK_SECRET=replace-with-random-secret
TRACCAR_TIMEOUT=5s
# Traccar 服务端 id（/api/server 的 id，通常为 1），决定别名 u{userId}@{serverId}。
TRACCAR_SERVER_ID=1

# ---- 极光 ----
JPUSH_APP_KEY=2e6135fffb1db1d409ab1d62
JPUSH_MASTER_SECRET=replace-with-jpush-master-secret
JPUSH_API_BASE=https://api.jpush.cn
JPUSH_TTL=3600
JPUSH_APNS_PRODUCTION=true
JPUSH_CHANNEL=developer-default

# ---- 存储 ----
STORE_BACKEND=redis
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=changeme
REDIS_DB=0

# ---- 业务策略 ----
# 别名有效期（秒），默认 90 天。
ALIAS_TTL=7776000s
# 幂等窗口（秒），默认 24 小时。
IDEMPOTENCY_TTL=24h
# 单用户每分钟推送上限，超出部分合并延后。
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_REQUEUE_DELAY=1m
# 免打扰时段（本地时间，跨零点用 22:00-07:00），留空表示不启用。
QUIET_HOURS=
QUIET_HOURS_TZ=Asia/Shanghai
# 延后队列投递间隔。
FLUSH_INTERVAL=1m
# 通知文案语言：zh / en。
DEFAULT_LOCALE=zh

# ---- 管理接口 ----
# 未设置时禁用 /v1/aliases 列表、/v1/dead、/v1/flush 等管理接口。
ADMIN_TOKEN=replace-with-admin-token

# ---- 联调 ----
# true 时不真正调用极光，只走完整流程并记录日志（没有密钥也能联调）。
DRY_RUN=false
